# Copy this file to .env and fill in real values:  Copy-Item .env.example .env
# .env is ignored by Git. NEVER put real passwords in this template.

# --- Local PostgreSQL container (development default) ---
POSTGRES_USER=amcos
POSTGRES_PASSWORD=change_me
POSTGRES_DB=amcos_db

# Backend -> database. "db" is the Docker Compose service name.
DATABASE_URL=postgresql+psycopg://amcos:change_me@db:5432/amcos_db

# Optional: hosted Neon database. To use it, put this value in DATABASE_URL instead.
# NEON_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require

# --- Backend ---
ENVIRONMENT=development
SECRET_KEY=change_me_run_python_-c_import_secrets_print_secrets.token_urlsafe_48
ACCESS_TOKEN_EXPIRE_MINUTES=15
CORS_ORIGINS=http://localhost:5173
TIMEZONE=Africa/Dar_es_Salaam

# --- Integrations (mock until real credentials exist) ---
SMS_PROVIDER=mock
PAYMENT_EXPORT_MODE=file
